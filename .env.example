# MarketLens - Environment Configuration
# ========================================
# Copy this file to .env and adjust values as needed.
# Environment variables are read with the MARKETLENS_ prefix.
# Never commit real credentials or API keys.

# Data directory configuration
MARKETLENS_DATA_DIR=./data
MARKETLENS_RAW_DATA_DIR=./data/raw
MARKETLENS_PROCESSED_DATA_DIR=./data/processed

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MARKETLENS_LOGGING_LEVEL=INFO
# Optional log file path; leave empty to log to stderr only
MARKETLENS_LOG_FILE=

# CSV ingestion configuration
MARKETLENS_MAX_UPLOAD_SIZE_MB=100
MARKETLENS_MAX_ACCEPTED_ROWS=100000

# Environment type
MARKETLENS_ENVIRONMENT=development

# LLM Intelligence Configuration (Optional - Batch 4)
# Leave provider empty to disable LLM intelligence generation (graceful offline behavior)
MARKETLENS_LLM_PROVIDER=
MARKETLENS_LLM_MODEL=gpt-4o-mini
# Read exclusively from environment; never commit real API keys
MARKETLENS_LLM_API_KEY=
MARKETLENS_LLM_API_BASE=
MARKETLENS_LLM_TEMPERATURE=0.0
MARKETLENS_LLM_MAX_TOKENS=2500
MARKETLENS_LLM_TIMEOUT_SECONDS=30.0
MARKETLENS_LLM_MAX_RETRIES=2
MARKETLENS_LLM_MAX_CONTEXT_REVIEWS=30
MARKETLENS_LLM_MAX_REVIEW_CHARS=300
MARKETLENS_REPORTS_DIR=./reports
